# URL gốc của backend Spring Boot (KHÔNG có dấu / ở cuối)
# Local
VITE_API_BASE_URL=http://localhost:8080/api

# Production (Vercel)
# VITE_API_BASE_URL=https://kltndigishop.onrender.com/api

# Client ID lấy từ Google Cloud Console > Google Auth Platform > Clients
# PHẢI trùng với GOOGLE_CLIENT_ID phía backend
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Facebook App ID (KHÔNG phải App Secret)
VITE_FACEBOOK_APP_ID=your_facebook_app_id
